{
  "realm": "fintrack",
  "enabled": true,
  "displayName": "Fintrack",
  "displayNameHtml": "Fintrack",
  "loginTheme": "fintrack",
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "passwordPolicy": "length(12) and digits(1) and lowerCase(1) and upperCase(1) and specialChars(1) and notUsername and notEmail",
  "clients": [
    {
      "clientId": "fintrack-api",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "rootUrl": "${FINTRACK_UI_ORIGIN:http://localhost:4200}",
      "redirectUris": ["${FINTRACK_UI_ORIGIN:http://localhost:4200}/*"],
      "webOrigins": ["${FINTRACK_UI_ORIGIN:http://localhost:4200}"],
      "attributes": {
        "post.logout.redirect.uris": "${FINTRACK_UI_ORIGIN:http://localhost:4200}/*"
      }
    }
  ],
  "users": [
    {
      "username": "demo",
      "email": "demo@fintrack.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "Demo@Fintrack1",
          "temporary": false
        }
      ]
    }
  ]
}
