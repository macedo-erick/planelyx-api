POSTGRES_DB=planelyx
POSTGRES_USER=planelyx
POSTGRES_PASSWORD=planelyx

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Credentials of the confidential `planelyx-api-admin` client, which the API uses to read and
# update the signed-in user's own profile through Keycloak's Admin API.
#
# The secret is one value with two consumers, so it lives under one key here and compose.yaml
# hands it to each side under the name that side expects: Keycloak reads
# PLANELYX_KEYCLOAK_ADMIN_CLIENT_SECRET when importing the realm, Spring reads
# KEYCLOAK_ADMIN_CLIENT_SECRET. Setting them separately is how they drift and 401.
#
# Keycloak only applies it on a realm's FIRST import. Changing it against a realm that already
# exists does nothing — update the client secret in the admin console instead, and keep this
# in step so a rebuilt realm comes back the same.
KEYCLOAK_ADMIN_CLIENT_ID=planelyx-api-admin
PLANELYX_KEYCLOAK_ADMIN_CLIENT_SECRET=local-dev-secret

# Comma-separated list of origins allowed to call the API from a browser.
PLANELYX_CORS_ORIGINS=http://localhost:4200

# Origin of the Angular app. Scopes the Keycloak client's redirect URIs and web
# origins; only applied when the realm is imported (i.e. on a fresh realm).
PLANELYX_UI_ORIGIN=http://localhost:4200
